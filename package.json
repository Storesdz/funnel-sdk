{
  "name": "@storesdz/funnel-sdk",
  "version": "1.1.0",
  "description": "Browser SDK for direct and isolated StoresDZ funnel pages",
  "main": "dist/storesdz-sdk.min.js",
  "jsdelivr": "dist/storesdz-sdk.min.js",
  "files": [
    "dist/storesdz-sdk.min.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Storesdz/funnel-sdk.git"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test tests/runtime.test.ts",
    "test:browser": "node tests/browser.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "bun pm pack --destination artifacts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "happy-dom": "20.14.6",
    "playwright": "1.62.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
